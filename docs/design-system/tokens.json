{
  "name": "Open FIMRA design tokens",
  "version": "0.2.0",
  "web": {
    "remBasePx": 16,
    "pageMaxPx": 1280
  },
  "primitives": {
    "palette": {
      "light": {
        "canvas": "#f5f6f4",
        "surface": "#ffffff",
        "ink": "#141816",
        "inkMuted": "#56615b",
        "lineSubtle": "#dde2de",
        "petrol": "#1f5a70",
        "onPetrol": "#ffffff",
        "petrolSoft": "#e2ebee",
        "redInk": "#9d2626",
        "scrim": "rgb(0 0 0 / 35%)",
        "surfaceRaised": "#ffffff",
        "lineStrong": "#737f78",
        "focusInk": "#1f5a70",
        "greenInk": "#246526",
        "shadowInk": "#000000"
      },
      "dark": {
        "canvas": "#121413",
        "surface": "#1b1e1c",
        "ink": "#eef1ef",
        "inkMuted": "#a7b1ab",
        "lineSubtle": "#2d3430",
        "petrol": "#97b5c1",
        "onPetrol": "#0a1a23",
        "petrolSoft": "#1c2b31",
        "redInk": "#ffa5a5",
        "scrim": "rgb(0 0 0 / 52%)",
        "surfaceRaised": "#242925",
        "lineStrong": "#87938b",
        "focusInk": "#abd6e7",
        "greenInk": "#9bdb92",
        "shadowInk": "#000000"
      }
    },
    "spacePx": {
      "base": 4,
      "steps": [
        4,
        8,
        12,
        16,
        24,
        32,
        48
      ]
    },
    "font": {
      "sans": "\"Inter Variable\", system-ui, sans-serif",
      "steps": {
        "xs": {
          "sizePx": 12,
          "lineHeightPx": 18,
          "weight": 500,
          "trackingEm": 0.012
        },
        "sm": {
          "sizePx": 14,
          "lineHeightPx": 22,
          "weight": 400,
          "trackingEm": 0
        },
        "base": {
          "sizePx": 16,
          "lineHeightPx": 24,
          "weight": 600,
          "trackingEm": -0.01
        },
        "lg": {
          "sizePx": 20,
          "lineHeightPx": 28,
          "weight": 600,
          "trackingEm": -0.02
        },
        "xl": {
          "sizePx": 24,
          "lineHeightPx": 32,
          "weight": 650,
          "trackingEm": -0.025
        },
        "xxl": {
          "sizePx": 32,
          "lineHeightPx": 40,
          "weight": 650,
          "trackingEm": -0.025
        }
      }
    },
    "radiusPx": {
      "control": 6,
      "card": 8,
      "panel": 12,
      "pill": 9999
    },
    "elevation": {
      "flat": "none",
      "menu": "0 10px 24px rgb(0 0 0 / 18%)",
      "dialog": "0 8px 28px rgb(0 0 0 / 22%)",
      "menuDp": 3,
      "dialogDp": 6
    },
    "focusPx": {
      "width": 3,
      "offset": 2
    },
    "motionMs": {
      "fast": 100,
      "normal": 200,
      "reduced": 0
    },
    "status": {
      "good": "#0ca30c",
      "warning": "#b48608",
      "serious": "#dc724c",
      "critical": "#d03b3b"
    }
  },
  "semantic": {
    "color": {
      "canvas": "primitives.palette.canvas",
      "surface": "primitives.palette.surface",
      "text": "primitives.palette.ink",
      "textSecondary": "primitives.palette.inkMuted",
      "divider": "primitives.palette.lineSubtle",
      "action": "primitives.palette.petrol",
      "actionText": "primitives.palette.onPetrol",
      "selected": "primitives.palette.petrolSoft",
      "danger": "primitives.palette.redInk",
      "scrim": "primitives.palette.scrim",
      "surfaceRaised": "primitives.palette.surfaceRaised",
      "controlBoundary": "primitives.palette.lineStrong",
      "focus": "primitives.palette.focusInk",
      "successText": "primitives.palette.greenInk",
      "shadow": "primitives.palette.shadowInk"
    },
    "focusPx": {
      "width": "primitives.focusPx.width",
      "offset": "primitives.focusPx.offset"
    },
    "type": {
      "label": "primitives.font.steps.xs",
      "body": "primitives.font.steps.sm",
      "subhead": "primitives.font.steps.base",
      "title": "primitives.font.steps.lg",
      "display": "primitives.font.steps.xl",
      "figure": "primitives.font.steps.xxl"
    },
    "radiusPx": {
      "control": "primitives.radiusPx.control",
      "card": "primitives.radiusPx.card",
      "panel": "primitives.radiusPx.panel",
      "pill": "primitives.radiusPx.pill"
    },
    "elevation": {
      "flat": "primitives.elevation.flat",
      "menu": "primitives.elevation.menu",
      "dialog": "primitives.elevation.dialog",
      "menuDp": "primitives.elevation.menuDp",
      "dialogDp": "primitives.elevation.dialogDp"
    },
    "motionMs": {
      "control": "primitives.motionMs.fast",
      "menu": "primitives.motionMs.fast",
      "dialog": "primitives.motionMs.normal",
      "reduced": "primitives.motionMs.reduced"
    },
    "status": {
      "good": "primitives.status.good",
      "warning": "primitives.status.warning",
      "serious": "primitives.status.serious",
      "critical": "primitives.status.critical"
    }
  },
  "density": {
    "comfortable": {
      "controlPx": 40,
      "rowPx": 48
    },
    "compact": {
      "controlPx": 32,
      "rowPx": 36
    },
    "touchTargetMinPx": {
      "web": 44,
      "mobile": 48
    }
  },
  "components": {
    "tableRow": {
      "height": "density.controlMode.rowPx",
      "divider": "semantic.color.divider",
      "selected": "semantic.color.selected"
    },
    "filterChip": {
      "height": "density.controlMode.controlPx",
      "radius": "semantic.radiusPx.pill",
      "background": "semantic.color.surface",
      "border": "semantic.color.controlBoundary",
      "selected": "semantic.color.selected"
    },
    "overlay": {
      "background": "semantic.color.surfaceRaised",
      "text": "semantic.color.text",
      "radius": "semantic.radiusPx.panel",
      "scrim": "semantic.color.scrim",
      "menuShadow": "semantic.elevation.menu",
      "dialogShadow": "semantic.elevation.dialog"
    },
    "status": {
      "successText": "semantic.color.successText",
      "good": "semantic.status.good",
      "warning": "semantic.status.warning",
      "serious": "semantic.status.serious",
      "critical": "semantic.status.critical",
      "errorText": "semantic.color.danger"
    },
    "mapControl": {
      "height": "density.controlMode.controlPx",
      "background": "semantic.color.surface",
      "border": "semantic.color.controlBoundary",
      "focus": "semantic.color.focus"
    }
  },
  "map": {
    "light": {
      "canvas": "#e9ece8",
      "land": "#ffffff",
      "line": "#cfd5d0",
      "neutralMark": "#7a857f",
      "forest": "#1aa373",
      "ageOutline": "#26180f",
      "selection": "#1f5a70"
    },
    "dark": {
      "canvas": "#1f2422",
      "land": "#1b1e1c",
      "line": "#2f3632",
      "neutralMark": "#8b958f",
      "forest": "#199e70",
      "ageOutline": "#eef1ef",
      "selection": "#97b5c1"
    },
    "forestOpacity": 0.34,
    "age": {
      "steps": [
        "under 6 hours",
        "6 to 24 hours",
        "1 to 3 days",
        "3 to 7 days"
      ],
      "light": [
        "#8f1d14",
        "#c8401f",
        "#cb602d",
        "#cb8154"
      ],
      "dark": [
        "#ffb38a",
        "#f0834a",
        "#d1552a",
        "#b44f31"
      ]
    },
    "symbols": {
      "insideForest": "filled circle",
      "nearEdge": "ring",
      "outside": "small neutral dot",
      "fixedHeatSource": "neutral square"
    }
  },
  "chart": {
    "series": {
      "light": [
        "#2a78d6",
        "#eb6834",
        "#1aa373",
        "#bb8500",
        "#d96995",
        "#008300",
        "#6250d6",
        "#e34948"
      ],
      "dark": [
        "#3987e5",
        "#d95926",
        "#199e70",
        "#c98500",
        "#d55181",
        "#0ca30c",
        "#9085e9",
        "#e66767"
      ]
    }
  },
  "logo": {
    "flame": "#d46838",
    "terrainLight": "#0c2d39",
    "terrainDark": "#97b5c1",
    "inkLight": "#19343f",
    "paper": "#f7f3ea",
    "night": "#0a1a23"
  },
  "compatibility": {
    "color": {
      "background": "semantic.color.canvas",
      "card": "semantic.color.surface",
      "border": "semantic.color.divider",
      "brand": "semantic.color.action",
      "brandForeground": "semantic.color.actionText",
      "brandSoft": "semantic.color.selected",
      "mapBackground": "map.canvas",
      "mapLine": "map.line",
      "neutralMark": "map.neutralMark"
    },
    "shadow": {
      "panel": "semantic.elevation.flat"
    }
  }
}
