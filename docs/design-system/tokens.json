{
  "name": "Open FIMRA design tokens",
  "version": "0.1.0",
  "color": {
    "light": {
      "background": "#f5f6f4",
      "card": "#ffffff",
      "text": "#141816",
      "textSecondary": "#56615b",
      "border": "#dde2de",
      "brand": "#1f5a70",
      "brandForeground": "#ffffff",
      "brandSoft": "#e2ebee",
      "mapBackground": "#e9ece8",
      "mapLine": "#cfd5d0",
      "neutralMark": "#7a857f"
    },
    "dark": {
      "background": "#121413",
      "card": "#1b1e1c",
      "text": "#eef1ef",
      "textSecondary": "#a7b1ab",
      "border": "#2d3430",
      "brand": "#97b5c1",
      "brandForeground": "#0a1a23",
      "brandSoft": "#1c2b31",
      "mapBackground": "#1f2422",
      "mapLine": "#2f3632",
      "neutralMark": "#8b958f"
    },
    "logo": {
      "comment": "Logo colours only. Copper is close to the fire-age colours, so it is never used for interface elements. See logo/README.md.",
      "flame": "#d46838",
      "terrainLight": "#0c2d39",
      "terrainDark": "#97b5c1",
      "inkLight": "#19343f",
      "paper": "#f7f3ea",
      "night": "#0a1a23"
    },
    "status": {
      "comment": "Reserved for state. Always shown with an icon and a label, never colour alone.",
      "good": "#0ca30c",
      "warning": "#fab219",
      "serious": "#ec835a",
      "critical": "#d03b3b"
    },
    "fireAge": {
      "comment": "Ordered, one hue. Index 0 is the most recent detection.",
      "steps": ["under 6 hours", "6 to 24 hours", "1 to 3 days", "3 to 7 days"],
      "light": ["#8f1d14", "#c8401f", "#e3743a", "#e9a36f"],
      "dark": ["#ffb38a", "#f0834a", "#d1552a", "#9c3a20"]
    },
    "chart": {
      "comment": "Used in this fixed order and never cycled. A ninth series folds into Other.",
      "light": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
      "dark": ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181", "#0ca30c", "#9085e9", "#e66767"]
    }
  },
  "mapSymbol": {
    "comment": "Shape carries forest class; colour carries fire age.",
    "insideForest": "filled circle",
    "nearEdge": "ring",
    "outside": "small neutral dot",
    "fixedHeatSource": "neutral square"
  },
  "font": {
    "sans": "Noto Sans",
    "mono": "Noto Sans Mono",
    "hosting": "Bundled with the app. No outside font services.",
    "sizePx": { "label": 12, "body": 14, "subhead": 16, "title": 20, "display": 24 }
  },
  "space": { "unitPx": 4 },
  "radiusPx": { "control": 6, "card": 8, "pill": 999 },
  "touchTargetMinPx": { "web": 32, "mobile": 48 },
  "components": {
    "library": "Spartan UI on Tailwind CSS",
    "tables": "TanStack Table",
    "forms": "ngx-formly",
    "icons": "Lucide",
    "charts": "Apache ECharts",
    "maps": "MapLibre GL JS with deck.gl"
  }
}
