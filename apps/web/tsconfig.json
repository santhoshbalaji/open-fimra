{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "paths": {
      "@open-fimra/form-schema": ["../../packages/form-schema/ts/form-schema.ts"],
      "@spartan-ng/helm/button": ["./src/ui/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/ui/utils/src/index.ts"],
      "@spartan-ng/helm/field": ["./src/ui/field/src/index.ts"],
      "@spartan-ng/helm/label": ["./src/ui/label/src/index.ts"],
      "@spartan-ng/helm/separator": ["./src/ui/separator/src/index.ts"],
      "@spartan-ng/helm/input": ["./src/ui/input/src/index.ts"],
      "@spartan-ng/helm/select": ["./src/ui/select/src/index.ts"],
      "@spartan-ng/helm/checkbox": ["./src/ui/checkbox/src/index.ts"],
      "@spartan-ng/helm/radio-group": ["./src/ui/radio-group/src/index.ts"],
      "@spartan-ng/helm/switch": ["./src/ui/switch/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./src/ui/textarea/src/index.ts"],
      "@spartan-ng/helm/dialog": ["./src/ui/dialog/src/index.ts"],
      "@spartan-ng/helm/sheet": ["./src/ui/sheet/src/index.ts"],
      "@spartan-ng/helm/tabs": ["./src/ui/tabs/src/index.ts"],
      "@spartan-ng/helm/table": ["./src/ui/table/src/index.ts"],
      "@spartan-ng/helm/badge": ["./src/ui/badge/src/index.ts"],
      "@spartan-ng/helm/card": ["./src/ui/card/src/index.ts"],
      "@spartan-ng/helm/dropdown-menu": ["./src/ui/dropdown-menu/src/index.ts"],
      "@spartan-ng/helm/tooltip": ["./src/ui/tooltip/src/index.ts"],
      "@spartan-ng/helm/sonner": ["./src/ui/sonner/src/index.ts"],
      "@spartan-ng/helm/alert": ["./src/ui/alert/src/index.ts"],
      "@spartan-ng/helm/skeleton": ["./src/ui/skeleton/src/index.ts"],
      "@spartan-ng/helm/empty": ["./src/ui/empty/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  }
}
