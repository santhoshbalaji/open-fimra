{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false, "packageManager": "pnpm" },
  "projects": {
    "web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist/web",
            "styles": ["src/styles.css"],
            "assets": [
              { "glob": "**/*", "input": "public", "output": "/" },
              { "glob": "LICENSE", "input": "node_modules/@fontsource-variable/inter", "output": "/licenses/inter" },
              { "glob": "LICENSE", "input": "src/ui", "output": "/licenses/spartan" },
              { "glob": "maplibre-gl-worker.mjs", "input": "node_modules/maplibre-gl/dist", "output": "/map" },
              { "glob": "lockup-{light,dark}.svg", "input": "linked/logo", "output": "/logo" },
              { "glob": "favicon-32.png", "input": "linked/logo", "output": "/logo" }
            ]
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "web:build:development", "host": "127.0.0.1", "port": 4200 }
        },
        "test": { "builder": "@angular/build:unit-test", "options": { "tsConfig": "tsconfig.spec.json" } }
      }
    }
  }
}
