---
import Satellite from "./Satellite.astro";
import Ground from "./Ground.astro";
import orbit from "../generated/orbit.json";

interface Props { step: number }
const { step } = Astro.props;
const point = ([lon, lat]: number[]) => `${((lon - 63) * 20).toFixed(1)},${((42 - lat) * 20).toFixed(1)}`;
const track = orbit.track.map(point).join(" ");
const swath = [...orbit.left, ...orbit.right.toReversed()].map(point).join(" ");
const cross = [orbit.left[90], orbit.right[90]].map(point).join(" ");
const [targetX, targetY] = point(orbit.target).split(",");
const labels = ["NOAA-20 in low Earth orbit", "Predicted ground track and VIIRS swath", "Nominal VIIRS footprint over a Sentinel-2 scene", "Plotted centre of the illustrated footprint"];
---
<div class:list={["frame", `frame-${step}`]} role="img" aria-label={labels[step]}>
  {step === 0 && <>
    <img class="frame-earth" src="/media/earth-night.webp" width="850" height="850" loading="lazy" alt="" />
    <svg class="frame-orbit" viewBox="0 0 780 510" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <ellipse cx="406" cy="325" rx="310" ry="110" transform="rotate(-26 406 325)" fill="none" stroke="#92aebf" stroke-dasharray="6 7"/>
      <path d="M521 121h68l39-35h56" fill="none" stroke="#b1cbd7"/>
      <circle cx="521" cy="121" r="4" fill="#ffb89d"/>
    </svg>
    <div class="frame-satellite"><Satellite /></div>
  </>}
  {step === 1 && <div class="frame-map">
    <img src="/media/terrain.webp" width="720" height="720" loading="lazy" alt="" />
    <svg viewBox="0 0 780 780" aria-hidden="true">
      <polygon points={swath} fill="#84d5ee" fill-opacity=".22" stroke="#a7d7e6" stroke-width="1.8"/>
      <polyline points={track} fill="none" stroke="#d3e6ee" stroke-width="2.5" stroke-dasharray="7 7"/>
      <polyline points={cross} fill="none" stroke="#ffe2d4" stroke-width="2.4"/>
      <circle cx={targetX} cy={targetY} r="9" fill="#ffab8f" stroke="#201512" stroke-width="3"/>
      <circle cx={targetX} cy={targetY} r="20" fill="none" stroke="#ffab8f" stroke-width="2"/>
    </svg>
  </div>}
  {step >= 2 && <div class="frame-pixel">
    <img src="/media/sentinel.webp" width="192" height="192" loading="lazy" alt="" />
    <svg viewBox="0 0 192 192" aria-hidden="true">
      <path d="M39.75 0v192m37.5-192v192m37.5-192v192m37.5-192v192M0 39.75h192M0 77.25h192M0 114.75h192M0 152.25h192" fill="none" stroke="#f3eee4" stroke-opacity=".42" stroke-width=".4"/>
      <rect x="77.25" y="77.25" width="37.5" height="37.5" fill="#db8278" fill-opacity=".22" stroke="#ffd4c2" stroke-width=".8"/>
      {step === 2 && <path d="m89 87 2 2-2 2-2-2z" fill="#ffc4ae" stroke="#351c18" stroke-width=".4"/>}
      {step === 3 && <><circle cx="96" cy="96" r="3.2" fill="#ffc4ae" stroke="#201512" stroke-width="1"/><circle cx="96" cy="96" r="7" fill="none" stroke="#ffd4c2" stroke-width=".6"/></>}
    </svg>
    {step === 3 && <div class="frame-ground"><Ground /></div>}
  </div>}
  <span class="frame-label mono" aria-hidden="true">
    {["NOAA-20  /  LOW EARTH ORBIT", "VIIRS  /  ~3,040 KM SWATH", "VIIRS  /  375 M AT NADIR", "FIRMS  /  PIXEL CENTRE"][step]}
  </span>
  <span class="frame-credit mono" aria-hidden="true">
    {["NASA BLACK MARBLE", "NASA BLUE MARBLE · CELESTRAK", "COPERNICUS SENTINEL-2 · 28 MAR 2026", "ILLUSTRATION OVER SENTINEL-2"][step]}
  </span>
</div>
