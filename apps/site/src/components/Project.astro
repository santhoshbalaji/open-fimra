---
import { independence, source } from "../lib/credits";
import FieldArt from "./FieldArt.astro";

const models = [
  ["standalone", "State standalone", "A department runs its own instance. It manages users, forest layers, workflows and records locally.", "Built · early development"],
  ["shared", "National shared installation", "A national operator hosts separate state workspaces for departments that want a managed installation. Each workspace has its own hierarchy, roles and data.", "Planned"],
  ["federated", "National view across state installations", "State teams keep running their own instances and approve the extracts they share. A national workspace receives those extracts and applies access rules.", "Receiving workflow built · pilot validation pending"],
] as const;
---
<section id="deploy" class="chapter deploy-chapter" aria-labelledby="deploy-title">
  <div class="wrap">
    <div class="chapter-intro">
      <span class="eyebrow mono"><span class="chapter-index">09</span> Deployment</span>
      <h2 id="deploy-title">Run where the data belongs.</h2>
      <p>Departments can operate their own installation. The roadmap also covers shared hosting and a national view based on approved exchanges.</p>
    </div>
    <ul class="deployment-grid">
      {models.map(([kind, name, copy, status]) => <li>
        <div class="art-board"><FieldArt kind={kind} /></div>
        <p class="mono model-status">{status}</p><h3>{name}</h3><p>{copy}</p>
      </li>)}
    </ul>
    <a class="text-link" href={source + "/blob/main/PLAN.md#3-users-and-deployment-models"}>Read the deployment plan <span aria-hidden="true">↗</span></a>
  </div>
</section>
<section id="open-source" class="chapter source-chapter" aria-labelledby="source-title">
  <div class="wrap source-grid">
    <div class="chapter-intro">
      <span class="eyebrow mono"><span class="chapter-index">10</span> Open source</span>
      <h2 id="source-title">Read the code and run it.</h2>
      <p>Open FIMRA ships under the GNU Affero General Public License v3. If you run a modified version over a network, offer its source to the people who use it.</p>
      <p class="small-copy">{independence}</p>
    </div>
    <div class="source-resources">
      <a href={source + "/blob/main/LICENSE"}><strong>AGPL‑3.0 licence</strong><span aria-hidden="true">↗</span></a>
      <a href={source + "/blob/main/PLAN.md#4-architecture"}><strong>Architecture and stack</strong><span aria-hidden="true">↗</span></a>
      <a href={source + "/blob/main/CONTRIBUTING.md"}><strong>Contributor guide</strong><span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<section id="involved" class="chapter involved-chapter" aria-labelledby="involved-title">
  <div class="wrap">
    <div class="chapter-intro">
      <span class="eyebrow mono"><span class="chapter-index">11</span> Get involved</span>
      <h2 id="involved-title">Help shape the first pilots.</h2>
      <p>Open FIMRA is in early development. Forest departments, field teams and contributors can help test the workflows on synthetic data and shape what comes next.</p>
    </div>
    <div class="involved-actions">
      <div><h3>Discuss a pilot</h3><p>Tell us which alert and field-reporting workflow you’d like to validate.</p><a class="button primary" href={source + "/issues/new"}>Start on GitHub <span aria-hidden="true">↗</span></a></div>
      <div><h3>Contribute to the project</h3><p>Run the synthetic demo, report a bug, or help with code and documentation.</p><a class="button secondary" href={source + "/blob/main/CONTRIBUTING.md"}>Read the contributor guide <span aria-hidden="true">↗</span></a></div>
    </div>
  </div>
</section>
