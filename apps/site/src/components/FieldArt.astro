    <circle class="art-hot" cx="121" cy="57" r="5"/>
    {kind === "fsi" && <path class="art-ink" d="m151 97 14-7m-93 1 12 6m70 12 19-9"/>}
  </>}
  {kind === "notify" && <>
    <rect class="art-fill" x="72" y="25" width="53" height="90" rx="8"/>
    <path class="art-ink" d="M73 40h51M73 101h51m-30 7h10"/>
    <rect class="art-paper" x="101" y="51" width="72" height="44" rx="4"/>
    <path class="art-ink" d="m102 54 35 25 35-25"/>
    <circle class="art-hot" cx="172" cy="50" r="6"/>
    <path class="art-dash" d="M182 65h17m-13 13h21"/>
  </>}
  {kind === "route" && <>
    <path class="art-dash" d="M120 40v15H69v14m51-14h51v14M69 87v18H49m20 0h22m80-18v18h-20m20 0h22"/>
    <rect class="art-paper" x="102" y="23" width="36" height="19" rx="3"/>
    <rect class="art-fill" x="52" y="69" width="34" height="19" rx="3"/>
