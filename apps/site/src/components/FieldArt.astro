---
type Kind = "orbit" | "receive" | "filter" | "notify" | "route" | "guard" | "return" |
  "policy" | "fsi" | "disaster" | "community" | "standalone" | "shared" | "federated";
interface Props { kind: Kind; }
const { kind } = Astro.props;
---
<svg class="field-art" viewBox="0 0 240 144" fill="none" aria-hidden="true">
  <g class="art-underlay">
    <path d="m30 105 89-51 91 51-91 35Z"/>
    <path d="m51 116 89-50m-64 62 90-49m-63 58 88-46M54 91l87 40M79 76l89 44m-65-58 91 49"/>
  </g>
  {kind === "orbit" && <>
