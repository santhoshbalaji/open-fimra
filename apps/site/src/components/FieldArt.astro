    <circle class="art-hot" cx="120" cy="47" r="5"/>
    <path class="art-ink" d="M68 75h10m84 0h10m-57 27h10"/>
  </>}
  {kind === "community" && <>
    <path class="art-fill" d="m80 83 40-36 43 36v29H80Z"/>
    <path class="art-paper" d="m71 82 49-43 52 43-7 8-45-37-42 37Z"/>
