  </>}
  {kind === "policy" && <>
    <path class="art-fill" d="m54 105 65-24 67 24-67 24Z"/>
    <path class="art-paper" d="m76 59 43 14v43l-43-15Zm43 14 45-14v42l-45 15Z"/>
    <path class="art-fill" d="M76 59v-12l43 14 45-14v12l-45 14Z"/>
    <path class="art-ink" d="m86 72 22 7m-22 5 22 7m22-11 23-7m-23 19 23-7"/>
    <circle class="art-hot" cx="119" cy="38" r="5"/>
    <path class="art-dash" d="M119 47v10"/>
  </>}
