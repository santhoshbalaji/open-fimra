# Copy to .env to override the development defaults. Never commit .env.
# These values are for the local development stack only.
# For shared worktrees, use a short .env with just these settings and free ports.
# FIMRA_SHARED=1
# FIMRA_HTTP_ADDR=127.0.0.1:18091
# WEB_PORT=4201
# MOBILE_WEB_PORT=4301
# Leave FIMRA_DB_NAME unset to derive it from the worktree directory.

# Standalone stack settings

FIMRA_DB_NAME=fimra
FIMRA_DB_USER=fimra
FIMRA_DB_PASSWORD=fimra-dev
FIMRA_DB_PORT=15432

FIMRA_KEYCLOAK_ADMIN=admin
FIMRA_KEYCLOAK_ADMIN_PASSWORD=admin-dev
FIMRA_KEYCLOAK_PORT=18180

# A fallback FIRMS key for workspaces without a key saved in the wizard.
# Leave empty to poll only workspaces with a saved key.
FIMRA_FIRMS_MAP_KEY=
# Live FIRMS cadence (Go duration, at least 1m) and comma-separated NRT products.
FIMRA_FIRMS_POLL_INTERVAL=5m
FIMRA_FIRMS_POLL_PRODUCTS=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
# Standard-processing products when -products (or PRODUCTS in Make) is omitted.
FIMRA_FIRMS_BACKFILL_PRODUCTS=VIIRS_NOAA20_SP,VIIRS_NOAA21_SP,MODIS_SP

# Public NOAA JPSS I-band Enterprise Fire feed. No key is required.
FIMRA_NOAA_NODD_ENABLED=false
FIMRA_NOAA_NODD_POLL_INTERVAL=5m
FIMRA_NOAA_NODD_SATELLITES=n20,n21

# Copernicus Sentinel-3 SLSTR fire radiative power. Requires CDSE S3 keys.
FIMRA_CDSE_ENABLED=false
FIMRA_CDSE_POLL_INTERVAL=10m
FIMRA_CDSE_S3_ACCESS_KEY=
FIMRA_CDSE_S3_ACCESS_KEY_FILE=
FIMRA_CDSE_S3_SECRET_KEY=
FIMRA_CDSE_S3_SECRET_KEY_FILE=

# Optional Meteosat-9 MSG-IODC FRP-PIXEL Demonstration feed (registered LSA SAF account).
FIMRA_LSASAF_ENABLED=false
FIMRA_LSASAF_POLL_INTERVAL=5m
FIMRA_LSASAF_USERNAME=
FIMRA_LSASAF_PASSWORD=
# Set a mounted password file or the password above.
FIMRA_LSASAF_PASSWORD_FILE=
FIMRA_LSASAF_PERSISTENCE_HITS=2
FIMRA_LSASAF_PERSISTENCE_SCANS=3

# Encrypts settings such as the FIRMS key. Make one with: openssl rand -base64 32
# Empty turns encrypted settings off. Keep a copy: saved secrets need it.
FIMRA_SETTINGS_KEY=
# Earlier settings keys, separated by commas, while rotating to a new key.
FIMRA_SETTINGS_OLD_KEYS=
# Optional one-time code to claim a fresh install. Empty prints a random code in the API log.
FIMRA_SETUP_CODE=
FIMRA_CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200

# Local files shared by the core API and geo worker. Make resolves relative paths from the repository root.
FIMRA_UPLOAD_DIR=.geo-uploads
# Export files written by the geo worker. Use a separate directory for each stack.
FIMRA_EXPORT_DIR=.geo-exports
# How long a finished export can be downloaded, as a Go duration such as 24h or 90m.
FIMRA_EXPORT_TTL=24h

# Photos and files from field reports: local (the directory below) or s3.
# Use a separate directory for each stack.
FIMRA_ATTACHMENT_STORE=local
FIMRA_ATTACHMENT_DIR=.form-attachments
FIMRA_ATTACHMENT_MAX_MB=25
# For FIMRA_ATTACHMENT_STORE=s3: any S3-compatible store, addressed by path.
FIMRA_S3_ENDPOINT=
FIMRA_S3_REGION=
FIMRA_S3_BUCKET=
FIMRA_S3_PREFIX=
FIMRA_S3_ACCESS_KEY=
FIMRA_S3_SECRET_KEY=

# Run make mail-up for the local mail catcher. Email is off by default.
FIMRA_MAILPIT_SMTP_PORT=11025
FIMRA_MAILPIT_HTTP_PORT=18025
FIMRA_SMTP_ADDR=
FIMRA_SMTP_FROM=
FIMRA_SMTP_SECURITY=starttls
FIMRA_SMTP_USERNAME=
FIMRA_SMTP_PASSWORD=
FIMRA_WEB_URL=

# Run make push-up for the local push server (ntfy). Push is off by default.
# To try it, set FIMRA_PUSH_SERVERS=http://127.0.0.1:18110 and point the
# phone's UnifiedPush app at the same server.
FIMRA_NTFY_PORT=18110
FIMRA_PUSH_SERVERS=
# Optional: Google's Firebase Cloud Messaging, from a service account key file.
FIMRA_PUSH_FCM_CREDENTIALS_FILE=
