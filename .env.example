# Copy to .env to override the development defaults. Never commit .env.
# These values are for the local development stack only.

FIMRA_DB_NAME=fimra
FIMRA_DB_USER=fimra
FIMRA_DB_PASSWORD=fimra-dev
FIMRA_DB_PORT=15432

FIMRA_KEYCLOAK_ADMIN=admin
FIMRA_KEYCLOAK_ADMIN_PASSWORD=admin-dev
FIMRA_KEYCLOAK_PORT=18180

# A fallback FIRMS key for workspaces without a key saved in the wizard.
# Leave empty to poll only workspaces with a saved key.
FIMRA_FIRMS_MAP_KEY=
# Encrypts settings such as the FIRMS key. Make one with: openssl rand -base64 32
# Empty turns encrypted settings off. Keep a copy: saved secrets need it.
FIMRA_SETTINGS_KEY=
# Earlier settings keys, separated by commas, while rotating to a new key.
FIMRA_SETTINGS_OLD_KEYS=
# Optional one-time code to claim a fresh install. Empty prints a random code in the API log.
FIMRA_SETUP_CODE=
FIMRA_CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200

# Local files shared by the core API and geo worker. Make resolves relative paths from the repository root.
FIMRA_UPLOAD_DIR=.geo-uploads
# Export files written by the geo worker. Use a separate directory for each stack.
FIMRA_EXPORT_DIR=.geo-exports
# How long a finished export can be downloaded, as a Go duration such as 24h or 90m.
FIMRA_EXPORT_TTL=24h

# Run make mail-up for the local mail catcher. Email is off by default.
FIMRA_MAILPIT_SMTP_PORT=11025
FIMRA_MAILPIT_HTTP_PORT=18025
FIMRA_SMTP_ADDR=
FIMRA_SMTP_FROM=
FIMRA_SMTP_SECURITY=starttls
FIMRA_SMTP_USERNAME=
FIMRA_SMTP_PASSWORD=
FIMRA_WEB_URL=
