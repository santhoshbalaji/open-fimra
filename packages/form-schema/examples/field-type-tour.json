{
  "$schema": "../form.schema.json",
  "formatVersion": 1,
  "id": "field-type-tour",
  "version": 3,
  "title": { "en": "Field type tour" },
  "description": { "en": "Not a real form. It uses every field type, structure, condition and calculation once, so the validators have one place to test them all." },
  "sections": [
    {
      "key": "basics",
      "title": { "en": "Basic fields" },
      "items": [
        {
          "key": "short_code",
          "type": "text",
          "label": { "en": "Demo code" },
          "minLength": 3,
          "maxLength": 12,
          "pattern": "DEMO-[A-Z]{2}[0-9]{2,4}",
          "patternHint": { "en": "DEMO-, two capital letters and two to four digits" }
        },
        { "key": "count_seen", "type": "number", "label": { "en": "Count" }, "decimals": 0, "min": 0, "max": 1000 },
        { "key": "visit_date", "type": "date", "label": { "en": "Visit date" }, "notInFuture": true },
        { "key": "visit_time", "type": "time", "label": { "en": "Visit time" } },
        { "key": "visit_moment", "type": "date-time", "label": { "en": "Visit date and time" } },
        {
          "key": "weather",
          "type": "single-choice",
          "label": { "en": "Weather" },
          "choices": [
            { "key": "dry", "label": { "en": "Dry" } },
            { "key": "windy", "label": { "en": "Windy" } },
            { "key": "rain", "label": { "en": "Rain" } }
          ]
        },
        {
          "key": "hazards",
          "type": "multiple-choice",
          "label": { "en": "Hazards" },
          "minSelected": 1,
          "maxSelected": 2,
          "choices": [
            { "key": "dry-grass", "label": { "en": "Dry grass" } },
            { "key": "steep-slope", "label": { "en": "Steep slope" } },
            { "key": "power-line", "label": { "en": "Power line" } }
          ]
        },
        {
          "key": "hazard_notes",
          "type": "text",
          "label": { "en": "About the hazards" },
          "showWhen": {
            "op": "all",
            "conditions": [
              { "op": "includes", "field": "hazards", "value": "power-line" },
              { "op": "not", "condition": { "op": "equals", "field": "weather", "value": "rain" } },
              { "op": "at-least", "field": "count_seen", "value": 1 },
              { "op": "less-than", "field": "visit_date", "value": "2099-12-31" },
              { "op": "at-most", "field": "visit_time", "value": "18:00" },
              { "op": "more-than", "field": "visit_moment", "value": "2000-01-01T00:00+05:30" }
            ]
          }
        }
      ]
    },
    {
      "key": "places",
      "title": { "en": "Places" },
      "items": [
        {
          "key": "map_group",
          "type": "group",
          "title": { "en": "Map" },
          "items": [
            { "key": "spot", "type": "point", "label": { "en": "Spot" } },
            { "key": "path", "type": "track", "label": { "en": "Path" } },
            { "key": "patch", "type": "polygon", "label": { "en": "Patch" } },
            {
              "key": "inner_group",
              "type": "group",
              "title": { "en": "Measurements" },
              "showWhen": { "op": "answered", "field": "patch" },
              "items": [
                { "key": "patch_area", "type": "calculated", "label": { "en": "Patch area" }, "unit": "ha", "decimals": 2, "calculate": { "op": "area", "field": "patch" } },
                { "key": "path_length", "type": "calculated", "label": { "en": "Path length" }, "unit": "km", "decimals": 2, "calculate": { "op": "length", "field": "path" } }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "evidence",
      "title": { "en": "Evidence" },
      "items": [
        { "key": "picture", "type": "photo", "label": { "en": "Picture" }, "minCount": 0, "maxCount": 2 },
        { "key": "witness_signature", "type": "signature", "label": { "en": "Signature" } },
        { "key": "attachment", "type": "file", "label": { "en": "Attachment" }, "minCount": 0, "maxCount": 1, "accept": [".pdf"] },
        { "key": "alert_confidence", "type": "alert-value", "label": { "en": "Confidence" }, "source": "confidence" },
        { "key": "alert_raised", "type": "alert-value", "label": { "en": "Alert raised at" }, "source": "raised-at" },
        { "key": "alert_source", "type": "alert-value", "label": { "en": "Satellite source" }, "source": "source" }
      ]
    },
    {
      "key": "crews_section",
      "title": { "en": "Crews" },
      "showWhen": { "op": "equals", "field": "weather", "value": "windy" },
      "items": [
        {
          "key": "crews",
          "type": "repeat",
          "title": { "en": "Crews" },
          "items": [
            { "key": "crew_size", "type": "number", "label": { "en": "Crew size" }, "unit": "people", "decimals": 0 },
            {
              "key": "shifts",
              "type": "repeat",
              "title": { "en": "Shifts" },
              "showWhen": { "op": "more-than", "field": "crew_size", "value": 0 },
              "items": [
                { "key": "shift_hours", "type": "number", "label": { "en": "Hours" }, "unit": "h", "decimals": 1 },
                {
                  "key": "shift_effort",
                  "type": "calculated",
                  "label": { "en": "Person hours" },
                  "unit": "h",
                  "calculate": { "op": "multiply", "args": [{ "op": "field", "field": "shift_hours" }, { "op": "field", "field": "crew_size" }] }
                }
              ]
            },
            { "key": "crew_hours", "type": "calculated", "label": { "en": "Crew hours" }, "unit": "h", "calculate": { "op": "sum", "group": "shifts", "field": "shift_effort" } }
          ]
        },
        {
          "key": "average_crew",
          "type": "calculated",
          "label": { "en": "Average crew size" },
          "decimals": 1,
          "calculate": {
            "op": "divide",
            "args": [
              { "op": "sum", "group": "crews", "field": "crew_size" },
              { "op": "add", "args": [{ "op": "count", "group": "crews" }, { "op": "number", "value": 0 }] }
            ]
          }
        },
        {
          "key": "spare_people",
          "type": "calculated",
          "label": { "en": "People beyond the first crew of ten" },
          "calculate": { "op": "subtract", "args": [{ "op": "sum", "group": "crews", "field": "crew_size" }, { "op": "number", "value": 10 }] }
        }
      ]
    }
  ]
}
