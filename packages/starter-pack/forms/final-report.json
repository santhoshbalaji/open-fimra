{
  "$schema": "../../form-schema/form.schema.json",
  "formatVersion": 1,
  "id": "final-report",
  "version": 1,
  "title": { "en": "Final report", "hi": "अंतिम रिपोर्ट" },
  "description": {
    "en": "The full record of the fire once it is out: the burnt area, the damage and the documents. A supervising officer checks it before verifying the alert."
  },
  "sections": [
    {
      "key": "incident",
      "title": { "en": "The fire" },
      "items": [
        { "key": "alert_id", "type": "alert-value", "label": { "en": "Alert number" }, "source": "alert-id" },
        { "key": "observed_at", "type": "alert-value", "label": { "en": "Seen by the satellite at" }, "source": "observed-at" },
        { "key": "extinguished_at", "type": "date-time", "label": { "en": "Fire put out at" }, "required": true, "notInFuture": true },
        {
          "key": "duration_hours",
          "type": "calculated",
          "label": { "en": "Hours from the alert to putting the fire out" },
          "unit": "h",
          "decimals": 1,
          "calculate": { "op": "hours-between", "start": "observed_at", "end": "extinguished_at" }
        }
      ]
    },
    {
      "key": "burnt",
      "title": { "en": "Burnt area" },
      "items": [
        {
          "key": "burnt_extent",
          "type": "polygon",
          "label": { "en": "Edge of the burnt area" },
          "hint": { "en": "Draw the edge on the map, or walk it with the phone." },
          "required": true,
          "maxAccuracyMetres": 20
        },
        { "key": "perimeter_walk", "type": "track", "label": { "en": "Route walked around the fire" }, "maxAccuracyMetres": 20 },
        {
          "key": "compartments",
          "type": "repeat",
          "title": { "en": "Compartments affected" },
          "itemLabel": { "en": "Compartment" },
          "items": [
            { "key": "compartment_name", "type": "text", "label": { "en": "Compartment" }, "required": true, "maxLength": 40 },
            { "key": "compartment_area", "type": "number", "label": { "en": "Area burnt in it" }, "unit": "ha", "decimals": 2, "min": 0 }
          ]
        },
        {
          "key": "compartment_total",
          "type": "calculated",
          "label": { "en": "Total of the compartment areas" },
          "unit": "ha",
          "decimals": 2,
          "calculate": { "op": "sum", "group": "compartments", "field": "compartment_area" }
        }
      ]
    },
    {
      "key": "damage",
      "title": { "en": "Damage" },
      "items": [
        {
          "key": "damage_types",
          "type": "multiple-choice",
          "label": { "en": "What was damaged" },
          "required": true,
          "choices": [
            { "key": "trees", "label": { "en": "Standing trees" } },
            { "key": "regeneration", "label": { "en": "Young plants" } },
            { "key": "wildlife", "label": { "en": "Wildlife" } },
            { "key": "grassland", "label": { "en": "Grassland" } },
            { "key": "property", "label": { "en": "Buildings or other property" } },
            { "key": "none", "label": { "en": "Nothing" } }
          ]
        },
        {
          "key": "wildlife_notes",
          "type": "text",
          "label": { "en": "What happened to wildlife" },
          "required": true,
          "maxLength": 1000,
          "showWhen": { "op": "includes", "field": "damage_types", "value": "wildlife" }
        },
        {
          "key": "property_loss",
          "type": "number",
          "label": { "en": "Estimated loss of property" },
          "unit": "rupees",
          "decimals": 0,
          "min": 0,
          "requireWhen": { "op": "includes", "field": "damage_types", "value": "property" }
        },
        { "key": "injuries", "type": "number", "label": { "en": "People hurt" }, "unit": "people", "decimals": 0, "min": 0 },
        {
          "key": "injury_details",
          "type": "text",
          "label": { "en": "How they were hurt" },
          "required": true,
          "showWhen": { "op": "more-than", "field": "injuries", "value": 0 }
        }
      ]
    },
    {
      "key": "documents",
      "title": { "en": "Documents and sign off" },
      "items": [
        {
          "key": "report_files",
          "type": "file",
          "label": { "en": "Scanned papers" },
          "maxCount": 3,
          "maxSizeMegabytes": 10,
          "accept": [".pdf", ".jpg", ".png"]
        },
        { "key": "officer_signature", "type": "signature", "label": { "en": "Signature of the range officer" }, "required": true },
        { "key": "signed_on", "type": "date", "label": { "en": "Signed on" }, "required": true, "notInFuture": true }
      ]
    }
  ]
}
