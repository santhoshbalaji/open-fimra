{
  "$schema": "../../form-schema/form.schema.json",
  "formatVersion": 1,
  "id": "preparedness-work",
  "version": 1,
  "title": {
    "en": "Preparedness work",
    "hi": "पूर्व तैयारी का कार्य"
  },
  "languages": [
    "en",
    "hi"
  ],
  "sections": [
    {
      "key": "details",
      "title": {
        "en": "Preparedness work",
        "hi": "पूर्व तैयारी का कार्य"
      },
      "items": [
        {
          "key": "work",
          "type": "text",
          "label": {
            "en": "Work and site",
            "hi": "कार्य और स्थल"
          },
          "required": true,
          "maxLength": 500
        },
        {
          "key": "work_reference",
          "type": "text",
          "label": {
            "en": "Work plan reference",
            "hi": "कार्य योजना का संदर्भ"
          },
          "required": false,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,119}$"
        },
        {
          "key": "target_date",
          "type": "date",
          "label": {
            "en": "Target date",
            "hi": "लक्ष्य तिथि"
          },
          "required": true
        },
        {
          "key": "result",
          "type": "text",
          "label": {
            "en": "Work done",
            "hi": "किया गया कार्य"
          },
          "required": false,
          "maxLength": 500
        },
        {"key": "target_quantity", "type": "number", "label": {"en": "Target number of work items", "hi": "कार्य मदों की लक्षित संख्या"}, "min": 0, "max": 10000000, "decimals": 0},
        {"key": "work_done_quantity", "type": "number", "label": {"en": "Number of work items completed", "hi": "पूरी की गई कार्य मदों की संख्या"}, "min": 0, "max": 10000000, "decimals": 0},
        {"key": "expenditure_inr", "type": "number", "label": {"en": "Expenditure in rupees", "hi": "रुपयों में खर्च"}, "min": 0, "max": 1000000000000, "decimals": 2}
      ]
    }
  ]
}
